# CogniBridge Backend Environment Variables
# 复制此文件为 .env 并填入真实值

# Qwen API (阿里云百炼)
DASHSCOPE_API_KEY=your-api-key-here

# Harness Version: v3 (improved) or v2 (legacy)
HARNESS_VERSION=v3

# Models
MODEL=qwen3.6-35b-a3b
TRANSLATE_MODEL=qwen-turbo

# Server
PORT=8000
HOST=0.0.0.0

# JWT Secret (生产环境必须修改)
SECRET_KEY=your-secret-key-here-change-in-production
