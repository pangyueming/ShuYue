# 数跃 ShuYue Backend Environment Variables
# 复制此文件为 .env 并填入真实值

# Qwen API (阿里云百炼)
DASHSCOPE_API_KEY=your-api-key-here

# Harness Version: v3 (improved) or v2 (legacy)
HARNESS_VERSION=v3

# Models
MODEL=qwen3.8-27b
DECISION_MODEL=qwen3.8-flash
TRANSLATE_MODEL=qwen-turbo

# Server
PORT=8001
HOST=127.0.0.1          # 生产：Nginx 反代，只监听本地；直连开发才用 0.0.0.0

# JWT Secret — leave unset and the server auto-generates a unique key
# on first start and persists it here (recommended for most deployments).
# SECRET_KEY=optional-custom-secret

# ===== Phase 0 (上线配置) =====
# 环境标识：production 时 P7 遥测统计默认只看生产数据
ENV=development

# 站点对外地址（用于重置密码邮件里的链接；不带末尾斜杠；生产=https://你的域名）
# OWASP：绝不从请求 Host 头生成链接
APP_BASE_URL=http://localhost:8001

# 阿里云邮件推送 DirectMail（SMTP 方式）— 密码重置/通知邮件
# 未配置时优雅降级：重置链接打印到服务器控制台（开发模式）
# SMTP_HOST=smtpdm.aliyun.com
# SMTP_PORT=465
# SMTP_USER=noreply@mail.你的域名.com
# SMTP_PASSWORD=你的SMTP密码
# MAIL_FROM=数跃 ShuYue <noreply@mail.你的域名.com>

# 管理员邮箱（唯一能访问 /api/agent/metrics/stats 的账号；留空=任何登录用户可看，仅限开发）
# ADMIN_EMAIL=you@example.com

# ===== P8 视觉问答（贴图即问） =====
# 两档 VL 路由：flash 提取/分类（便宜快），plus 批改/讲解（质量档）
VISION_MODEL_PLUS=qwen3-vl-plus
VISION_MODEL_FLASH=qwen3-vl-flash
# 批改每日配额（每用户；解题/讲解/追问不限）
VISION_GRADE_DAILY_LIMIT=20
